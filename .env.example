APP_NAME=SIH26099 Material Harmonization
ENVIRONMENT=development
DEBUG=false
LOGGING_LEVEL=INFO
# Keep credentials out of source control. Set this to your cloud PostgreSQL URL.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
MATCH_EQUIVALENT_THRESHOLD=0.82
MATCH_REVIEW_THRESHOLD=0.58
RETRIEVAL_TOP_K=5
